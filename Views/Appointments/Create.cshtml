@model Appointment
@{
    ViewData["Title"] = "Book a Viewing";
}

<div class="container mt-5 pt-4 mb-5">
    <div class="card p-5 border-0 mx-auto" style="width: 100%; max-width: 750px; background-color: #FFFFFF; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);">
        <div class="mb-4">
            <h2 style="color: #7C203A; font-family: 'Playfair Display', serif; font-weight: 700;">Book a Viewing</h2>
            <div style="width: 50px; height: 2px; background-color: #D4B895; margin-top: 0.5rem; margin-bottom: 1.5rem;"></div>
            <p style="color: #6B5B53; font-size: 0.95rem;">Schedule a visit for your preferred property by filling out the details below.</p>
        </div>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-4" style="font-size: 0.9rem;"></div>

            <div class="row">
                <div class="col-md-6 mb-4">
                    <label asp-for="PropertyId" class="form-label" style="color: #2C1E16; font-weight: 500;"></label>
                    <select asp-for="PropertyId" class="form-select" asp-items="ViewBag.PropertyId" style="border: 1px solid #E6DFD3; padding: 0.75rem 1rem; border-radius: 4px;">
                        <option value="">-- Select property --</option>
                    </select>
                    <span asp-validation-for="PropertyId" class="text-danger" style="font-size: 0.85rem;"></span>
                </div>

                <div class="col-md-6 mb-4">
                    <label asp-for="RequestedDate" class="form-label" style="color: #2C1E16; font-weight: 500;"></label>
                    <input asp-for="RequestedDate" type="datetime-local" class="form-control" style="border: 1px solid #E6DFD3; padding: 0.75rem 1rem; border-radius: 4px;" />
                    <span asp-validation-for="RequestedDate" class="text-danger" style="font-size: 0.85rem;"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-4">
                    <label asp-for="VisitorName" class="form-label" style="color: #2C1E16; font-weight: 500;"></label>
                    <input asp-for="VisitorName" class="form-control" style="border: 1px solid #E6DFD3; padding: 0.75rem 1rem; border-radius: 4px;" />
                    <span asp-validation-for="VisitorName" class="text-danger" style="font-size: 0.85rem;"></span>
                </div>

                <div class="col-md-6 mb-4">
                    <label asp-for="VisitorPhone" class="form-label" style="color: #2C1E16; font-weight: 500;"></label>
                    <input asp-for="VisitorPhone" class="form-control" style="border: 1px solid #E6DFD3; padding: 0.75rem 1rem; border-radius: 4px;" />
                    <span asp-validation-for="VisitorPhone" class="text-danger" style="font-size: 0.85rem;"></span>
                </div>
            </div>

            <div class="mb-5">
                <label asp-for="Notes" class="form-label" style="color: #2C1E16; font-weight: 500;"></label>
                <textarea asp-for="Notes" class="form-control" rows="3" style="border: 1px solid #E6DFD3; padding: 0.75rem 1rem; border-radius: 4px; resize: none;"></textarea>
            </div>

            <div class="d-flex gap-3">
                <button type="submit" class="btn px-5 py-2" style="background-color: #7C203A; color: #F9F7F3; font-weight: 500; border: none; border-radius: 4px;">Confirm Booking</button>
                <a asp-action="Index" class="btn px-4 py-2" style="background-color: transparent; color: #7C203A; border: 1px solid #7C203A; font-weight: 500; border-radius: 4px; text-decoration: none;">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
