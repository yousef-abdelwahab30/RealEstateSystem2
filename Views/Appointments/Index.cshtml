@model List<Appointment>
@{
    ViewData["Title"] = "Appointments";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Viewing Appointments</h2>
    <a asp-action="Create" class="btn btn-primary">Add New</a>
</div>

<table class="table table-bordered table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Property</th>
            <th>Visitor</th>
            <th>Phone</th>
            <th>Visit Date</th>
            <th>Status</th>
            <th style="width:250px">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Property?.Title</td>
                <td>@item.VisitorName</td>
                <td>@item.VisitorPhone</td>
                <td>@item.RequestedDate.ToString("dd/MM/yyyy HH:mm")</td>
                <td>
                    @if (item.Status == AppointmentStatus.Confirmed)
                    {
                        <span class="badge bg-success">@item.Status</span>
                    }
                    else if (item.Status == AppointmentStatus.Pending)
                    {
                        <span class="badge bg-warning text-dark">@item.Status</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@item.Status</span>
                    }
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                    @if (item.Status == AppointmentStatus.Pending)
                    {
                        <form asp-action="Confirm" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn btn-sm btn-success">Confirm</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
