@model Appointment
@{
    ViewData["Title"] = "Delete Appointment";
}

<h2 class="text-danger">Delete Appointment</h2>
<h5>Are you sure you want to delete this?</h5>
<hr />

<dl class="row">
    <dt class="col-sm-3">Property</dt>
    <dd class="col-sm-9">@Model.Property?.Title</dd>

    <dt class="col-sm-3">Visitor</dt>
    <dd class="col-sm-9">@Model.VisitorName</dd>

    <dt class="col-sm-3">Visit Date</dt>
    <dd class="col-sm-9">@Model.RequestedDate.ToString("dd/MM/yyyy HH:mm")</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>
