@model Appointment
@{
    ViewData["Title"] = "Appointment Details";
}

<h2>Appointment Details</h2>
<hr />

<dl class="row">
    <dt class="col-sm-3">Property</dt>
    <dd class="col-sm-9">@Model.Property?.Title</dd>

    <dt class="col-sm-3">Visitor</dt>
    <dd class="col-sm-9">@Model.VisitorName</dd>

    <dt class="col-sm-3">Phone</dt>
    <dd class="col-sm-9">@Model.VisitorPhone</dd>

    <dt class="col-sm-3">Visit Date</dt>
    <dd class="col-sm-9">@Model.RequestedDate.ToString("dd/MM/yyyy HH:mm")</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>

    <dt class="col-sm-3">Notes</dt>
    <dd class="col-sm-9">@Model.Notes</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>
