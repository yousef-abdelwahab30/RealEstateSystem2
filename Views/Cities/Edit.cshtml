@model City
@{
    ViewData["Title"] = "Edit City";
}

<div class="container mt-5 pt-4 mb-5">
    <div class="card p-5 border-0 mx-auto" style="width: 100%; max-width: 600px; background-color: #FFFFFF; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);">
        <div class="mb-4">
            <h2 style="color: #7C203A; font-family: 'Playfair Display', serif; font-weight: 700;">Edit City</h2>
            <div style="width: 50px; height: 2px; background-color: #D4B895; margin-top: 0.5rem; margin-bottom: 1.5rem;"></div>
            <p style="color: #6B5B53; font-size: 0.95rem;">Update the details of the city below.</p>
        </div>

        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-4" style="font-size: 0.9rem;"></div>
            <input type="hidden" asp-for="Id" />

            <div class="mb-4">
                <label asp-for="Name" class="form-label" style="color: #2C1E16; font-weight: 500;"></label>
                <input asp-for="Name" class="form-control" style="border: 1px solid #E6DFD3; padding: 0.75rem 1rem; border-radius: 4px;" />
                <span asp-validation-for="Name" class="text-danger" style="font-size: 0.85rem;"></span>
            </div>

            <div class="mb-5">
                <label asp-for="Governorate" class="form-label" style="color: #2C1E16; font-weight: 500;"></label>
                <input asp-for="Governorate" class="form-control" style="border: 1px solid #E6DFD3; padding: 0.75rem 1rem; border-radius: 4px;" />
                <span asp-validation-for="Governorate" class="text-danger" style="font-size: 0.85rem;"></span>
            </div>

            <div class="d-flex gap-3">
                <button type="submit" class="btn px-5 py-2" style="background-color: #7C203A; color: #F9F7F3; font-weight: 500; border: none; border-radius: 4px;">Save Changes</button>
                <a asp-action="Index" class="btn px-4 py-2" style="background-color: transparent; color: #7C203A; border: 1px solid #7C203A; font-weight: 500; border-radius: 4px; text-decoration: none;">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
