@model List<PropertyImage>
@{
    ViewData["Title"] = "Property Images";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Property Images</h2>
    <a asp-action="Create" class="btn btn-primary">Add New</a>
</div>

<table class="table table-bordered table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th style="width:140px">Preview</th>
            <th>Property</th>
            <th>Image URL</th>
            <th>Order</th>
            <th style="width:220px">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td><img src="@item.ImageUrl" style="width:120px;height:80px;object-fit:cover" /></td>
                <td>@item.Property?.Title</td>
                <td class="small">@item.ImageUrl</td>
                <td>@item.DisplayOrder</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
