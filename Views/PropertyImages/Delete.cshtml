@model PropertyImage
@{
    ViewData["Title"] = "Delete Image";
}

<h2 class="text-danger">Delete Image</h2>
<h5>Are you sure you want to delete this?</h5>
<hr />

<img src="@Model.ImageUrl" class="img-fluid rounded mb-3" style="max-width:400px" />

<dl class="row">
    <dt class="col-sm-3">Property</dt>
    <dd class="col-sm-9">@Model.Property?.Title</dd>

    <dt class="col-sm-3">Image URL</dt>
    <dd class="col-sm-9">@Model.ImageUrl</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>
