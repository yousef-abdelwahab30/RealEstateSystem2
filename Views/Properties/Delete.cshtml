@model Property
@{
    ViewData["Title"] = "Delete Property";
}

<div class="container mt-5 pt-4 mb-5">
    <div class="card p-5 border-0 mx-auto" style="width: 100%; max-width: 700px; background-color: #FFFFFF; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);">
        <div class="mb-4 text-center">
            <h2 style="color: #7C203A; font-family: 'Playfair Display', serif; font-weight: 700;">Delete Property</h2>
            <div style="width: 50px; height: 2px; background-color: #D4B895; margin: 0.5rem auto 1.5rem auto;"></div>
            <p style="color: #7C203A; font-size: 1.05rem; font-weight: 500;">Are you sure you want to delete this property? This action cannot be undone.</p>
        </div>

        <div class="p-4 mb-4" style="background-color: #F9F7F3; border-radius: 4px; border: 1px solid #E6DFD3;">
            <dl class="row mb-0">
                <dt class="col-sm-4 mb-3" style="color: #6B5B53; font-weight: 500;">Title</dt>
                <dd class="col-sm-8 mb-3" style="color: #2C1E16; font-weight: 600;">@Model.Title</dd>

                <dt class="col-sm-4 mb-3" style="color: #6B5B53; font-weight: 500;">Type</dt>
                <dd class="col-sm-8 mb-3" style="color: #2C1E16; font-weight: 600;">@Model.PropertyType?.Name</dd>

                <dt class="col-sm-4 mb-3" style="color: #6B5B53; font-weight: 500;">City</dt>
                <dd class="col-sm-8 mb-3" style="color: #2C1E16; font-weight: 600;">@Model.City?.Name</dd>

                <dt class="col-sm-4 mb-3" style="color: #6B5B53; font-weight: 500;">Address</dt>
                <dd class="col-sm-8 mb-3" style="color: #2C1E16; font-weight: 600;">@Model.Address</dd>

                <dt class="col-sm-4 mb-0" style="color: #6B5B53; font-weight: 500;">Price</dt>
                <dd class="col-sm-8 mb-0" style="color: #2C1E16; font-weight: 600;">@Model.Price.ToString("N0") EGP</dd>
            </dl>
        </div>

        <form asp-action="Delete" method="post" class="d-flex justify-content-center gap-3 mt-4">
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn px-5 py-2" style="background-color: #7C203A; color: #F9F7F3; font-weight: 500; border: none; border-radius: 4px;">Confirm Delete</button>
            <a asp-action="Index" class="btn px-4 py-2" style="background-color: transparent; color: #7C203A; border: 1px solid #7C203A; font-weight: 500; border-radius: 4px; text-decoration: none;">Cancel</a>
        </form>
    </div>
</div>
