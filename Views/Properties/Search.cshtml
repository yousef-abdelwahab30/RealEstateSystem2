@model List<Property>
@{
    ViewData["Title"] = "Search Properties";
}

<h2>Search Properties</h2>
<hr />

<form asp-action="Search" method="get" class="row g-3 mb-4">
    <div class="col-md-3">
        <label class="form-label">City</label>
        <select name="cityId" class="form-select" asp-items="ViewBag.CityId">
            <option value="">All cities</option>
        </select>
    </div>

    <div class="col-md-3">
        <label class="form-label">Property Type</label>
        <select name="propertyTypeId" class="form-select" asp-items="ViewBag.PropertyTypeId">
            <option value="">All types</option>
        </select>
    </div>

    <div class="col-md-2">
        <label class="form-label">For</label>
        <select name="listingType" class="form-select">
            <option value="">Sale or Rent</option>
            <option value="0">Sale</option>
            <option value="1">Rent</option>
        </select>
    </div>

    <div class="col-md-2">
        <label class="form-label">Min Price</label>
        <input type="number" name="minPrice" class="form-control" />
    </div>

    <div class="col-md-2">
        <label class="form-label">Max Price</label>
        <input type="number" name="maxPrice" class="form-control" />
    </div>

    <div class="col-md-2">
        <label class="form-label">Min Bedrooms</label>
        <input type="number" name="bedrooms" class="form-control" />
    </div>

    <div class="col-md-3 d-flex align-items-end">
        <button type="submit" class="btn btn-primary">Search</button>
        <a asp-action="Index" class="btn btn-secondary ms-2">All Properties</a>
    </div>
</form>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No properties match your search.</div>
}
else
{
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(item.MainImageUrl))
                    {
                        <img src="@item.MainImageUrl" class="card-img-top" style="height:200px;object-fit:cover" />
                    }
                    <div class="card-body">
                        <h5 class="card-title">@item.Title</h5>
                        <p class="text-muted mb-1">@item.City?.Name — @item.PropertyType?.Name</p>
                        <p class="fw-bold text-primary">@item.Price.ToString("N0") EGP</p>
                        <p class="small">
                            @item.Bedrooms bed · @item.Bathrooms bath · @item.Area m²
                        </p>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-primary">View</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
