@model Property
@{
    ViewData["Title"] = Model.Title;
}

<h2>@Model.Title</h2>
<hr />

<div class="row">
    <div class="col-md-7">
        @if (!string.IsNullOrEmpty(Model.MainImageUrl))
        {
            <img src="@Model.MainImageUrl" class="img-fluid rounded mb-3" />
        }

        @if (Model.Images != null && Model.Images.Count > 0)
        {
            <div class="row">
                @foreach (var img in Model.Images)
                {
                    <div class="col-4 mb-2">
                        <img src="@img.ImageUrl" class="img-fluid rounded" />
                    </div>
                }
            </div>
        }

        <h5 class="mt-3">Description</h5>
        <p>@Model.Description</p>
    </div>

    <div class="col-md-5">
        <dl class="row">
            <dt class="col-sm-5">Price</dt>
            <dd class="col-sm-7 fw-bold text-primary">@Model.Price.ToString("N0") EGP</dd>

            <dt class="col-sm-5">Listing</dt>
            <dd class="col-sm-7">@Model.ListingType</dd>

            <dt class="col-sm-5">Type</dt>
            <dd class="col-sm-7">@Model.PropertyType?.Name</dd>

            <dt class="col-sm-5">City</dt>
            <dd class="col-sm-7">@Model.City?.Name</dd>

            <dt class="col-sm-5">Address</dt>
            <dd class="col-sm-7">@Model.Address</dd>

            <dt class="col-sm-5">Area</dt>
            <dd class="col-sm-7">@Model.Area m²</dd>

            <dt class="col-sm-5">Bedrooms</dt>
            <dd class="col-sm-7">@Model.Bedrooms</dd>

            <dt class="col-sm-5">Bathrooms</dt>
            <dd class="col-sm-7">@Model.Bathrooms</dd>

            <dt class="col-sm-5">Furnished</dt>
            <dd class="col-sm-7">@(Model.IsFurnished ? "Yes" : "No")</dd>

            <dt class="col-sm-5">Agent</dt>
            <dd class="col-sm-7">@Model.Agent?.FullName</dd>

            <dt class="col-sm-5">Status</dt>
            <dd class="col-sm-7">@Model.Status</dd>

            <dt class="col-sm-5">Listed On</dt>
            <dd class="col-sm-7">@Model.CreatedAt.ToShortDateString()</dd>
        </dl>

        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>
