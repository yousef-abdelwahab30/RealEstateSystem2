@model Property
@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-5 pt-4 mb-5">
    <div class="mb-4">
        <h2 style="color: #7C203A; font-family: 'Playfair Display', serif; font-weight: 700; font-size: 2.2rem;">@Model.Title</h2>
        <div style="width: 60px; height: 2px; background-color: #D4B895; margin-top: 0.5rem; margin-bottom: 1.5rem;"></div>
    </div>

    <div class="row g-5">
        <div class="col-lg-7">
            @if (!string.IsNullOrEmpty(Model.MainImageUrl))
            {
                <div style="border-radius: 8px; overflow: hidden; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04); margin-bottom: 1.5rem;">
                    <img src="@Model.MainImageUrl" class="img-fluid w-100" style="object-fit: cover; max-height: 450px;" alt="@Model.Title" />
                </div>
            }

            @if (Model.Images != null && Model.Images.Count > 0)
            {
                <div class="row g-3 mb-5">
                    @foreach (var img in Model.Images)
                    {
                        <div class="col-4">
                            <div style="border-radius: 6px; overflow: hidden; height: 120px; box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);">
                                <img src="@img.ImageUrl" class="img-fluid w-100 h-100" style="object-fit: cover;" alt="Property Image" />
                            </div>
                        </div>
                    }
                </div>
            }

            <div class="p-4" style="background-color: #FFFFFF; border: 1px solid #E6DFD3; border-radius: 8px; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.02);">
                <h4 style="color: #2C1E16; font-family: 'Playfair Display', serif; font-weight: 700; margin-bottom: 1rem;">Property Description</h4>
                <p style="color: #6B5B53; line-height: 1.8; font-size: 1.05rem; white-space: pre-line;">@Model.Description</p>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card p-4 border-0 sticky-top" style="top: 2rem; background-color: #F9F7F3; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04); border-radius: 8px; border: 1px solid #E6DFD3;">
                <h3 class="mb-4" style="color: #7C203A; font-family: 'Playfair Display', serif; font-weight: 700; font-size: 2rem;">@Model.Price.ToString("N0") <span style="font-size: 1.2rem; color: #6B5B53; font-family: 'Outfit', sans-serif;">EGP</span></h3>
                
                <div style="width: 100%; height: 1px; background-color: #E6DFD3; margin-bottom: 1.5rem;"></div>

                <dl class="row mb-4">
                    <dt class="col-sm-5 mb-3" style="color: #6B5B53; font-weight: 500;">Listing</dt>
                    <dd class="col-sm-7 mb-3" style="color: #2C1E16; font-weight: 600;">@Model.ListingType</dd>

                    <dt class="col-sm-5 mb-3" style="color: #6B5B53; font-weight: 500;">Type</dt>
                    <dd class="col-sm-7 mb-3" style="color: #2C1E16; font-weight: 600;">@Model.PropertyType?.Name</dd>

                    <dt class="col-sm-5 mb-3" style="color: #6B5B53; font-weight: 500;">City</dt>
                    <dd class="col-sm-7 mb-3" style="color: #2C1E16; font-weight: 600;">@Model.City?.Name</dd>

                    <dt class="col-sm-5 mb-3" style="color: #6B5B53; font-weight: 500;">Address</dt>
                    <dd class="col-sm-7 mb-3" style="color: #2C1E16; font-weight: 600;">@Model.Address</dd>

                    <dt class="col-sm-5 mb-3" style="color: #6B5B53; font-weight: 500;">Area</dt>
                    <dd class="col-sm-7 mb-3" style="color: #2C1E16; font-weight: 600;">@Model.Area m²</dd>

                    <dt class="col-sm-5 mb-3" style="color: #6B5B53; font-weight: 500;">Bedrooms</dt>
                    <dd class="col-sm-7 mb-3" style="color: #2C1E16; font-weight: 600;">@Model.Bedrooms</dd>

                    <dt class="col-sm-5 mb-3" style="color: #6B5B53; font-weight: 500;">Bathrooms</dt>
                    <dd class="col-sm-7 mb-3" style="color: #2C1E16; font-weight: 600;">@Model.Bathrooms</dd>

                    <dt class="col-sm-5 mb-3" style="color: #6B5B53; font-weight: 500;">Furnished</dt>
                    <dd class="col-sm-7 mb-3" style="color: #2C1E16; font-weight: 600;">@(Model.IsFurnished ? "Yes" : "No")</dd>

                    <dt class="col-sm-5 mb-3" style="color: #6B5B53; font-weight: 500;">Agent</dt>
                    <dd class="col-sm-7 mb-3" style="color: #2C1E16; font-weight: 600;">@Model.Agent?.FullName</dd>

                    <dt class="col-sm-5 mb-3" style="color: #6B5B53; font-weight: 500;">Status</dt>
                    <dd class="col-sm-7 mb-3" style="color: #2C1E16; font-weight: 600;">
                        <span style="background-color: #FFFFFF; border: 1px solid #D4B895; padding: 0.2rem 0.6rem; border-radius: 4px; font-size: 0.85rem;">@Model.Status</span>
                    </dd>

                    <dt class="col-sm-5 mb-0" style="color: #6B5B53; font-weight: 500;">Listed On</dt>
                    <dd class="col-sm-7 mb-0" style="color: #2C1E16; font-weight: 600;">@Model.CreatedAt.ToShortDateString()</dd>
                </dl>

                <div class="d-flex flex-column gap-2 mt-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn py-2 text-center" style="background-color: #7C203A; color: #F9F7F3; font-weight: 500; border: none; border-radius: 4px; text-decoration: none; width: 100%;">Edit Property</a>
                    <a asp-action="Index" class="btn py-2 text-center" style="background-color: transparent; color: #7C203A; border: 1px solid #7C203A; font-weight: 500; border-radius: 4px; text-decoration: none; width: 100%;">Back to List</a>
                </div>
            </div>
        </div>
    </div>
</div>
