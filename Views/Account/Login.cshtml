@model LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="container d-flex justify-content-center align-items-center mt-5 pt-4">
    <div class="card p-5 border-0" style="width: 100%; max-width: 500px; background-color: #FFFFFF; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);">
        <div class="text-center mb-4">
            <h2 style="color: #7C203A; font-family: 'Playfair Display', serif; font-weight: 700;">Welcome Back</h2>
            <div style="width: 50px; height: 2px; background-color: #D4B895; margin: 0.5rem auto 1rem auto;"></div>
            <p style="color: #6B5B53; font-size: 0.95rem;">Please enter your credentials to access your account.</p>
        </div>

        <form asp-action="Login" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3" style="font-size: 0.9rem;"></div>

            <div class="mb-4">
                <label asp-for="Email" class="form-label" style="color: #2C1E16; font-weight: 500;"></label>
                <input asp-for="Email" class="form-control" style="border: 1px solid #E6DFD3; padding: 0.75rem 1rem; border-radius: 4px;" />
                <span asp-validation-for="Email" class="text-danger" style="font-size: 0.85rem;"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Password" class="form-label" style="color: #2C1E16; font-weight: 500;"></label>
                <input asp-for="Password" class="form-control" style="border: 1px solid #E6DFD3; padding: 0.75rem 1rem; border-radius: 4px;" />
                <span asp-validation-for="Password" class="text-danger" style="font-size: 0.85rem;"></span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="RememberMe" class="form-check-input" style="border-color: #D4B895;" />
                <label asp-for="RememberMe" class="form-check-label" style="color: #6B5B53; font-size: 0.95rem;"></label>
            </div>

            <button type="submit" class="btn w-100 py-2 mb-3" style="background-color: #7C203A; color: #F9F7F3; font-weight: 500; border: none; border-radius: 4px; font-size: 1.1rem;">Login</button>
        </form>

        <div class="text-center mt-2">
            <p style="color: #6B5B53; font-size: 0.95rem;">
                Don't have an account? <a asp-action="Register" style="color: #7C203A; font-weight: 600; text-decoration: none;">Register here</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
